{
	"name": "dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sourceTable1_employees_datafalow",
						"type": "DatasetReference"
					},
					"name": "source1Table1Employees"
				},
				{
					"dataset": {
						"referenceName": "ds_sourceTable2_employees_info_dataflow",
						"type": "DatasetReference"
					},
					"name": "source2Table2employeesinfo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_target_dataflow",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id as integer,",
				"          name as string,",
				"          dep as string,",
				"          salary as decimal(10,2),",
				"          last_updated as timestamp",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1Table1Employees",
				"source(output(",
				"          id as integer,",
				"          location as string,",
				"          mobile_num as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2Table2employeesinfo",
				"source1Table1Employees, source2Table2employeesinfo join(source1Table1Employees@id == source2Table2employeesinfo@id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1 filter(equals(dep, 'IT')) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     partitionFileNames:['dataflowetloutput'],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     mapColumn(",
				"          id = source1Table1Employees@id,",
				"          name,",
				"          dep,",
				"          salary,",
				"          last_updated,",
				"          location,",
				"          mobile_num",
				"     ),",
				"     partitionBy('hash', 1)) ~> sink1"
			]
		}
	}
}